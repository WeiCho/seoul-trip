{#- ═══════════════════════════════════════════════════════════════
    首爾旅程手冊樣板：jyuutaku-family.co.jp 的淡雅風格，手機（iPhone）優先。
    設計決定記在 DESIGN.md；共用腳本在 _scripts.j2（換日、今日模式、記帳、檢查清單、
    緊急彈窗、深色／大字、?edit=1 編輯器，沿用九州手冊），英文字型在 _questrial_font.j2。
    ═══════════════════════════════════════════════════════════════ -#}
{%- macro em_icon(i) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if i == 0 -%}<path d="M12 3 4 6v6c0 4.5 3.2 7.6 8 9 4.8-1.4 8-4.5 8-9V6z"/>
{%- elif i == 1 -%}<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>
{%- elif i == 2 -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><ellipse cx="12" cy="12" rx="4" ry="9"/>
{%- elif i == 3 -%}<path d="M3 21h18M4 10h16M12 3 3 8h18zM7 10v11M11 10v11M15 10v11M19 10v11"/>
{%- elif i == 4 -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/>
{%- else -%}<path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z"/><path d="M12 12v6a3 3 0 0 0 6 0"/>
{%- endif -%}
</svg>
{%- endmacro -%}
{#- 參考站的「View more ⟶」：文字＋黑色小膠囊箭頭 -#}
{%- macro pill() -%}
<span class="pill" aria-hidden="true"><svg viewBox="0 0 24 12"><path d="M2 6h19M16 1.5 21 6l-5 4.5"/></svg></span>
{%- endmacro -%}
{#- 幾何字標：三個三角形＋一塊方形，向參考站的 logo 借語法，不借形 -#}
{%- macro mark() -%}
<svg class="mark" viewBox="0 0 44 30" aria-hidden="true" focusable="false">
  <path class="m1" d="M0 30V12l18 18z"/><path class="m2" d="M8 0h14v30H8z"/><path class="m3" d="M24 0h20L24 20z"/><path class="m4" d="M44 30H26l18-18z"/>
</svg>
{%- endmacro -%}
{%- macro handoff(lead) -%}
<div class="handoff"><span>{{ lead }}</span></div>
{%- endmacro -%}
{%- set TYPE_META = {
  "景點": {"cls": "t-see"},
  "餐廳": {"cls": "t-eat"},
  "交通": {"cls": "t-go"},
  "住宿": {"cls": "t-stay"},
  "購物": {"cls": "t-shop"},
} -%}
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ trip.title }}｜旅程手冊</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#f8f9fb" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="{{ trip.hero_word or trip.title }}">
<link rel="apple-touch-icon" href="icon.svg">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<script>
(function(){var d=document.documentElement;
  d.className += " js";
  try{
  var t=localStorage.getItem("theme")||(window.matchMedia&&matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light");
  d.setAttribute("data-theme",t);
  if(localStorage.getItem("textsize")==="large")d.setAttribute("data-theme-size","large");
}catch(e){d.setAttribute("data-theme","light");}})();
</script>
<style>
{% include '_questrial_font.j2' %}
/* ══════════════════════════════════════════════════════════════
   jyuutaku-family.co.jp 的語法（2026-10-09 看站＋讀 style.css）：
     · 底 #f8f9fb、字 #292d33、唯一主色天藍 #6ac3f1（深一階 #22a3e5）
     · Questrial 細體英文大標＋下方一行小字日文；內文 Noto Sans 400/500，字重輕
     · 首屏是一條彎曲的照片帶；滿版照片上浮白色圓角卡（8–10px）
     · 「View more ⟶」：文字＋底線＋黑色小膠囊箭頭；頁尾全黑；右下浮一個直式標籤
   ══════════════════════════════════════════════════════════════ */
:root{
  --paper:#f8f9fb; --ink:#292d33; --line:#dee2e6; --card:#ffffff; --muted:#525a66; --soft:#8f9db2;
  --warm:#d6261f; --focus:#22a3e5; --pine:#292d33; --sage:#eef1f5;
  --sky:#6ac3f1; --sky-d:#1b7fb3; --sky-l:#a0cbe5; --sky-t:#e6f4fc;
  --black:#0b0b0e; --on-black:#e9ecf1; --on-black-mute:#9aa3b2;
  /* 中文用手機內建字（iPhone 是蘋方、韓文是 Apple SD Gothic Neo），不下載中文字型：快、離線也一樣 */
  --sans:-apple-system,"PingFang TC","Apple SD Gothic Neo","Noto Sans TC","Noto Sans KR","Microsoft JhengHei",system-ui,sans-serif;
  --latin:"Questrial",-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;
  --gut:clamp(18px,5vw,72px);
  --r:10px;
  --out:cubic-bezier(.22,1,.36,1);
  --img:url("{% include '_hero_image.j2' %}");
  color-scheme:light;
}
:root[data-theme="dark"]{
  --paper:#0f1114; --ink:#e9ecf1; --line:#2c3138; --card:#181b20; --muted:#a7b0bd; --soft:#7d8796;
  --warm:#ff6b5f; --focus:#6ac3f1; --pine:#e9ecf1; --sage:#1d2127;
  --sky-d:#6ac3f1; --sky-t:#14252f;
  --black:#050506;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-weight:400;font-size:15.5px;line-height:1.9;letter-spacing:.04em;
  -webkit-font-smoothing:antialiased;overflow-x:clip;
}
::selection{background:var(--sky);color:#0b0b0e}
:focus-visible{outline:2px solid var(--focus);outline-offset:3px;border-radius:4px}
a{color:inherit;text-underline-offset:.3em;text-decoration-thickness:1px}
[hidden]{display:none !important}
h1,h2,h3,h4{margin:0;font-weight:500;line-height:1.4}
p{margin:0}
.skip{position:absolute;left:-9999px}
.skip:focus{left:16px;top:16px;z-index:100;background:var(--ink);color:var(--paper);padding:8px 14px;border-radius:6px}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:#b9c1cc;border-radius:999px}
::-webkit-scrollbar-track{background:transparent}

/* 黑色小膠囊箭頭（View more 的那顆） */
.pill{display:inline-grid;place-items:center;width:36px;height:22px;border-radius:999px;background:var(--ink);color:var(--paper);flex:none;transition:transform .5s var(--out),background .3s}
.pill svg{width:16px;height:9px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.more{
  display:inline-flex;align-items:center;justify-content:space-between;gap:28px;min-height:44px;
  padding-bottom:6px;border-bottom:1px solid var(--ink);text-decoration:none;font-size:14.5px;
}
.more:hover .pill{transform:translateX(6px);background:var(--sky-d)}

/* ── 頂列：左字標、右文字導覽＋天藍按鈕＋三條線 ── */
.sticky-nav{position:fixed;inset:0 0 auto;z-index:50;transition:background .4s}
.sticky-nav::before{content:"";position:absolute;inset:0;background:color-mix(in srgb,var(--paper) 86%,transparent);backdrop-filter:blur(10px);opacity:0;transition:opacity .4s}
html.scrolled .sticky-nav::before{opacity:1}
.nav-inner{position:relative;display:flex;align-items:center;gap:clamp(14px,2vw,28px);height:68px;padding:0 var(--gut)}
.brand{display:flex;align-items:center;gap:10px;margin-right:auto;text-decoration:none;line-height:1.2}
.mark{width:34px;height:23px;fill:var(--ink)}
.brand span{display:grid}
.brand small{font-family:var(--latin);font-size:9.5px;letter-spacing:.16em;color:var(--muted)}
.brand b{font-weight:700;font-size:15px;letter-spacing:.14em}
.nav-links{display:flex;align-items:center;gap:clamp(14px,1.8vw,30px)}
.nav-links a{font-size:14px;text-decoration:none;letter-spacing:.08em;padding:6px 0;position:relative}
.nav-links a::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform .4s var(--out)}
.nav-links a:hover::after,.nav-links a.active::after{transform:scaleX(1);transform-origin:left}
.nav-links a.nav-urgent{display:grid;place-items:center;height:40px;padding:0 20px;border-radius:6px;background:var(--sky);color:#0b0b0e;font-weight:500}
.nav-links a.nav-urgent::after{display:none}
.nav-links a.nav-urgent.active{background:var(--sky-d);color:#fff}
.nav-tools{position:relative}
.tools-toggle{display:grid;gap:6px;width:44px;height:44px;place-content:center;background:none;border:0;cursor:pointer;color:var(--ink)}
.tools-toggle i{display:block;width:26px;height:1px;background:currentColor;transition:transform .4s var(--out)}
.tools-toggle[aria-expanded="true"] i:nth-child(1){transform:translateY(7px) rotate(25deg)}
.tools-toggle[aria-expanded="true"] i:nth-child(2){opacity:0}
.tools-toggle[aria-expanded="true"] i:nth-child(3){transform:translateY(-7px) rotate(-25deg)}
.tools-menu{
  position:absolute;right:0;top:calc(100% + 8px);min-width:220px;display:grid;gap:6px;padding:14px;
  background:var(--card);border-radius:var(--r);box-shadow:0 20px 40px -18px rgba(41,45,51,.35);
}
.drawer-links{display:none}
.nav-tool{
  min-height:44px;border:1px solid var(--line);border-radius:6px;background:none;color:var(--ink);
  font-family:var(--latin);font-size:13px;letter-spacing:.14em;cursor:pointer;transition:border-color .3s,background .3s;
}
.nav-tool:hover{border-color:var(--ink)}
.nav-tool[aria-pressed="true"]{background:var(--sky-t);border-color:var(--sky)}

/* 右下角直式浮標：參考站的「物件情報」，這裡跳到交通 */
.float-tab{
  position:fixed;right:clamp(10px,1.6vw,24px);bottom:clamp(14px,3vh,28px);z-index:40;
  display:flex;flex-direction:column;align-items:center;gap:8px;width:46px;padding:14px 0 16px;border-radius:8px;
  background:var(--sky);color:#0b0b0e;text-decoration:none;
  font-size:13px;font-weight:500;letter-spacing:.3em;box-shadow:0 10px 24px -12px rgba(34,163,229,.8);
  transition:transform .5s var(--out);
}
.float-tab svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5}
.float-tab span{writing-mode:vertical-rl}
.float-tab:hover{transform:translateY(-4px)}

/* ── 封面：左邊細體英文＋一行中文，右邊彎曲照片帶 ── */
.hero{
  position:relative;min-height:min(100svh,880px);padding:120px var(--gut) clamp(40px,7vh,72px);
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);grid-template-rows:1fr auto;gap:28px clamp(16px,3vw,40px);align-items:center;
}
.hero-copy{position:relative;z-index:2}
.hero-copy h1{font-family:var(--latin);font-weight:400;font-size:clamp(38px,5vw,72px);line-height:1.12;letter-spacing:.005em}
.hero-copy .sub{margin-top:18px;font-size:clamp(16px,1.4vw,20px);font-weight:500;letter-spacing:.16em}
.hero-copy .meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:22px;font-family:var(--latin);font-size:13.5px;letter-spacing:.14em;color:var(--muted)}
.hero-copy .meta span{display:inline-flex;align-items:center;gap:8px}
.hero-copy .meta span::before{content:"";width:16px;height:1px;background:var(--sky-d)}
/* 彎曲照片帶：同一張北村照片切成五片，左右兩端轉向觀者、放大，像站在弧形牆裡看出去 */
.band-strip{position:relative;perspective:1100px;height:clamp(230px,30vw,430px)}
.band-strip .row{display:flex;gap:clamp(5px,.7vw,10px);height:100%;transform-style:preserve-3d}
.pn{
  flex:1;border-radius:6px;background-image:var(--img);background-size:500% auto;background-repeat:no-repeat;
  background-position:var(--x) 16%;transform:rotateY(var(--ry)) scale(var(--s));transform-origin:var(--o) 50%;
  box-shadow:0 24px 40px -26px rgba(41,45,51,.55);
}
@media (prefers-reduced-motion:no-preference){
  .pn{animation:panel 1.1s var(--out) both;animation-delay:calc(var(--i) * 90ms + .15s)}
  .hero-copy>*{animation:up 1s var(--out) both}
  .hero-copy .sub{animation-delay:.12s} .hero-copy .meta{animation-delay:.22s}
  .mark path{animation:tri .9s var(--out) both}
  .mark .m2{animation-delay:.08s} .mark .m3{animation-delay:.16s} .mark .m4{animation-delay:.24s}
}
@keyframes panel{from{opacity:0;transform:rotateY(var(--ry)) scale(var(--s)) translateY(26px)}}
@keyframes up{from{opacity:0;transform:translateY(18px)}}
@keyframes tri{from{opacity:0;transform:translate(-6px,6px)}}
@keyframes sheet{from{transform:translateY(40px);opacity:.4}}
/* 封面左下的「News」區：放倒數，與參考站首屏左下的最新消息同位置 */
.card-deck{grid-column:1/-1;align-self:end;max-width:460px;display:grid}
.card-deck .card-live{grid-area:1/1;transition:transform .35s var(--out),opacity .35s}
.card-live{transform:translateY(var(--dy,0)) scale(var(--sc,1));opacity:var(--op,1);z-index:var(--z,1)}
.card-live.is-dragging{transition:none}
.card-hello{display:grid;grid-template-columns:auto 1fr;gap:4px 20px;align-items:baseline}
.hello-head{font-family:var(--latin);font-size:18px;grid-column:1/-1;display:flex;align-items:center;gap:14px}
.hello-head::after{content:"";flex:1;height:1px;background:var(--line)}
.hello-title{font-size:13.5px;color:var(--muted)}
.hello-fun{display:none}
.hello-stub{display:contents}
.hello-route{grid-column:1;font-family:var(--latin);font-size:13px;letter-spacing:.14em;color:var(--muted);display:flex;align-items:center;gap:6px}
.hello-route svg{width:22px;height:8px;fill:none;stroke:currentColor;stroke-width:1.2}
.hello-count{grid-column:2;grid-row:2;display:flex;align-items:baseline;gap:8px}
.hello-k{font-size:13.5px}
.hello-n{font-family:var(--latin);font-size:30px;line-height:1;color:var(--sky-d)}
.hello-u{font-family:var(--latin);font-size:13px;color:var(--muted)}
.hello-stamp{display:none}
.card-live:not(.card-hello){background:var(--card);border-radius:var(--r);padding:14px 18px;box-shadow:0 14px 30px -20px rgba(41,45,51,.4)}
.card-live .who{font-weight:500;text-decoration:none}
.card-live .state{font-family:var(--latin);font-size:18px}
.card-live .upd{font-size:12px;margin-left:8px;color:var(--muted)}
.live-tag{margin-left:8px;padding:1px 8px;border-radius:4px;background:var(--sky-t);font-size:12px}
.card-live .keys{font-size:13px;color:var(--muted);white-space:pre-line}
.deck-dots{display:flex;gap:6px;margin-top:8px}
.deck-dots button{width:8px;height:8px;border-radius:50%;border:1px solid var(--ink);background:none;padding:0;cursor:pointer}
.deck-dots button[aria-current="true"]{background:var(--ink)}

/* ── 章節共用：細體英文大標，下方一行小字中文 ── */
main{display:block}
.band{position:relative}
.section{padding:clamp(72px,12vh,140px) var(--gut) clamp(32px,6vh,64px);max-width:1360px;margin:0 auto}
.section-heading{margin-bottom:clamp(30px,5vh,56px)}
.section-heading h2{font-family:var(--latin);font-weight:400;font-size:clamp(34px,4.4vw,64px);line-height:1.1;letter-spacing:.005em}
.section-heading .zh{display:block;margin-top:8px;font-size:13px;letter-spacing:.2em}
.section-heading p{margin-top:16px;max-width:44em;color:var(--muted);font-size:14.5px}
.handoff{display:flex;justify-content:center;padding:clamp(16px,3vh,32px) var(--gut)}
.handoff span{display:inline-flex;align-items:center;gap:14px;font-size:13px;letter-spacing:.2em;color:var(--muted)}
.handoff span::before,.handoff span::after{content:"";width:40px;height:1px;background:var(--line)}
.pending-banner{max-width:1360px;margin:0 auto;padding:96px var(--gut) 0}
.pending-banner details{background:var(--sky-t);border-radius:var(--r);padding:12px 18px}
.pending-banner summary{cursor:pointer;font-weight:500}
.pending-banner ul{margin:6px 0 0;padding-left:1.2em;font-size:14px}

/* ── 行程 ── */
.daypick{display:flex;gap:clamp(18px,3vw,40px);overflow-x:auto;scrollbar-width:none;margin-bottom:clamp(26px,4vh,40px);border-bottom:1px solid var(--line)}
.daypick::-webkit-scrollbar{display:none}
.dp{display:grid;gap:0;padding:6px 0 12px;text-decoration:none;position:relative;flex:none;color:var(--soft);transition:color .3s}
.dp b{font-family:var(--latin);font-weight:400;font-size:20px;letter-spacing:.06em}
.dp b::before{content:"Day ";font-size:.62em;letter-spacing:.12em}
.dp small{font-size:12px;letter-spacing:.1em}
.dp small i{font-style:normal;margin-left:4px}
.dp::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--sky);transform:scaleX(0);transition:transform .5s var(--out)}
.dp:hover{color:var(--ink)}
.dp[aria-current="page"]{color:var(--ink)}
.dp[aria-current="page"]::after{transform:scaleX(1)}
.dp.is-today small::after{content:" · 今日";color:var(--sky-d)}
.js .day:not(.is-on){display:none}
.day-grid{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,2fr);gap:clamp(24px,4vw,64px);align-items:start}
/* 左欄是一張浮在淡色上的白卡，對應參考站「事業內容」浮在照片上的卡 */
.day-aside{position:sticky;top:88px;background:var(--card);border-radius:var(--r);padding:clamp(20px,2.4vw,30px);box-shadow:0 18px 40px -28px rgba(41,45,51,.45)}
.day-num{font-family:var(--latin);font-size:13px;letter-spacing:.2em;color:var(--sky-d)}
.day-name{margin-top:8px;font-size:clamp(17px,1.4vw,20px);font-weight:500;line-height:1.6}
.day-date{margin-top:4px;font-family:var(--latin);font-size:13px;letter-spacing:.1em;color:var(--muted)}
.day-weather{margin-top:16px;padding-top:14px;border-top:1px solid var(--line);font-size:14px}
.wx-src{display:block;font-size:11.5px;color:var(--soft)}
.wx-spread{margin-top:6px;font-size:13px;color:var(--warm)}
.wx-hours{margin-top:14px;padding-top:10px;border-top:1px solid var(--line)}
.wx-hours summary{display:flex;justify-content:space-between;cursor:pointer;min-height:40px;align-items:center;font-size:14px}
.wx-hours summary b{font-family:var(--latin);font-weight:400}
.wx-more{font-size:12px;color:var(--soft)}
.wx-hours ol{list-style:none;margin:6px 0 8px;padding:0;display:flex;gap:4px;overflow-x:auto}
.wx-hours li{display:grid;justify-items:center;min-width:40px;padding:6px 2px;border-radius:6px;background:var(--sage);font-size:11.5px}
.wx-hours li b{font-family:var(--latin);font-weight:400;font-size:14px}
.wx-hours li.wet{background:var(--sky-t)}
.wx-hours .p{color:var(--sky-d)}
.day-note{margin-top:14px;padding:12px 14px;border-radius:8px;background:var(--sky-t);font-size:13.5px;line-height:1.8}
.day-aside .more{margin-top:14px;width:100%;font-size:13.5px}
.route-cap{display:block;font-size:11.5px;color:var(--soft)}

.timeline{list-style:none;margin:0;padding:0}
.stop{
  display:grid;grid-template-columns:72px minmax(0,1fr) auto;align-items:center;gap:14px;
  padding-block:8px;border-bottom:1px solid var(--line);
}
.stop time{font-family:var(--latin);font-size:18px;letter-spacing:.04em;color:var(--muted)}
/* 名稱本身就是按鈕：點了跳出說明。右邊淡淡的箭頭提示「可以點」 */
.stop-name{
  display:flex;align-items:center;gap:10px;min-height:52px;padding:6px 0;margin:0;border:0;background:none;cursor:pointer;
  font:inherit;font-size:16px;font-weight:500;line-height:1.55;letter-spacing:.03em;color:var(--ink);text-align:left;
}
.stop-name::after{content:"";flex:none;width:6px;height:6px;margin-left:auto;border:solid var(--soft);border-width:1.5px 1.5px 0 0;transform:rotate(45deg)}
.stop-name:hover{color:var(--sky-d)}
.nav-btn{
  display:inline-grid;place-items:center;min-height:34px;padding:0 13px;border-radius:999px;
  background:var(--sky-t);color:var(--sky-d);text-decoration:none;font-size:13px;font-weight:500;letter-spacing:.08em;
}
.nav-btn:hover{background:var(--sky);color:#0b0b0e}
.t-go{--tc:var(--sky-d)} .t-eat{--tc:#d9762b} .t-stay{--tc:#2f9a76} .t-see{--tc:#c4487c} .t-shop{--tc:#7a63c9}
:root[data-theme="dark"] .t-eat{--tc:#f0a062} :root[data-theme="dark"] .t-stay{--tc:#5cc9a2} :root[data-theme="dark"] .t-see{--tc:#ec7fad} :root[data-theme="dark"] .t-shop{--tc:#a895ef}
.kind{display:inline-flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.16em;color:var(--tc)}
.kind::before{content:"";width:14px;height:1px;background:currentColor}
.stop h4{margin-top:2px;font-size:clamp(16px,1.25vw,17.5px);font-weight:500;line-height:1.6}
.stop h4 .name{text-decoration:underline;text-decoration-color:var(--sky)}
.stop .desc{margin-top:6px;font-size:14px;line-height:1.9;color:var(--muted);max-width:46em;white-space:pre-line}
.stop .meta{margin-top:6px;font-size:12.5px;color:var(--soft);letter-spacing:.06em}
.links{display:flex;flex-wrap:wrap;gap:6px 22px;margin-top:8px}
.loc{display:inline-flex;align-items:center;gap:10px;min-height:36px;text-decoration:none;font-size:13px;border-bottom:1px solid var(--line)}
.loc .pill{width:28px;height:18px}
.loc:hover .pill{transform:translateX(4px);background:var(--sky-d)}
.go{display:flex;align-items:center;gap:10px;margin-top:10px;font-size:13px;color:var(--muted);text-decoration:none}
.go::before{content:"";width:18px;height:1px;background:var(--sky-d);flex:none}
a.go span{font-family:var(--latin);font-size:11px;letter-spacing:.14em;color:var(--sky-d)}
.stop.past{opacity:.4}
.daybar{display:flex;align-items:center;justify-content:center;gap:22px;margin-top:clamp(26px,4vh,40px)}
.daybar .arw{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;transition:border-color .3s}
.daybar .arw:hover:not(:disabled){border-color:var(--ink)}
.daybar .arw:disabled{opacity:.35;cursor:default}
.daybar .arw svg{width:16px;height:9px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.daybar #day-prev svg{transform:rotate(180deg)}
.daybar .th{font-family:var(--latin);font-size:15px;letter-spacing:.16em;min-width:6em;text-align:center}
.today-badge{margin-left:8px;padding:1px 8px;border-radius:4px;background:var(--sky-t);font-family:var(--sans);font-size:12px}

/* ── 交通：滿版照片＋浮在上面的白卡（參考站的 Business） ── */
.band-photo{position:relative;isolation:isolate}
.band-photo::before{
  content:"";position:absolute;inset:0;z-index:-1;background-image:var(--img);background-size:cover;background-position:50% 22%;
}
.band-photo::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(15,30,45,.35),rgba(15,30,45,.15) 40%,color-mix(in srgb,var(--paper) 92%,transparent) 100%)}
.band-photo .section-heading{color:#fff;text-align:center}
.band-photo .section-heading p{color:rgba(255,255,255,.92);margin-inline:auto}
.band-photo .tr-note{display:inline-block;margin-top:14px;padding:8px 16px;border-radius:6px;background:rgba(255,255,255,.16);backdrop-filter:blur(6px);color:#fff;font-size:13.5px}
.band-photo .daypick{justify-content:center;border-bottom-color:rgba(255,255,255,.35)}
.band-photo .dp{color:rgba(255,255,255,.7)}
.band-photo .dp:hover,.band-photo .dp[aria-current="page"]{color:#fff}
.js .tday:not(.is-on){display:none}
.tday-date{text-align:center;font-family:var(--latin);font-size:13px;letter-spacing:.14em;color:#fff;margin-bottom:18px}
.tday-date span{font-family:var(--sans);margin-left:10px}
.transit-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:clamp(14px,2vw,24px);align-items:start}
.transit-row{background:var(--card);border-radius:var(--r);padding:clamp(20px,2.6vw,32px);box-shadow:0 24px 50px -30px rgba(15,30,45,.55)}
.tr-head{margin-bottom:14px}
.tr-when{display:block;font-family:var(--latin);font-size:12px;letter-spacing:.2em;color:var(--sky-d)}
.tr-route{display:block;margin-top:4px;font-size:clamp(16px,1.3vw,18px);font-weight:500;line-height:1.6}
a.tr-route{text-decoration:underline;text-decoration-color:var(--sky)}
.tr-meta{display:grid;gap:0;margin:0}
.tr-meta div{display:grid;grid-template-columns:4.5em minmax(0,1fr);gap:12px;padding:10px 0;border-top:1px solid var(--line)}
.tr-meta dt{font-size:12.5px;color:var(--soft);letter-spacing:.1em}
.tr-meta dd{margin:0;font-size:14px;line-height:1.85;white-space:pre-line}
.tr-meta .tr-warn dt{color:var(--sky-d)}
.tr-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--lc);margin-right:8px;vertical-align:1px}
.transit-links{display:flex;flex-wrap:wrap;gap:8px 32px;margin-top:clamp(26px,4vh,40px)}
.transit-links .more{font-size:13.5px}

/* ── 口袋名單：參考站「Company」的列表——左欄標題，右欄一列一列，線＋箭頭 ── */
.wish-wrap{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,2fr);gap:clamp(24px,5vw,80px)}
.wish-side{position:sticky;top:96px;align-self:start}
.wish-side .section-heading{margin-bottom:20px}
.wish-jump{display:grid;gap:4px}
.wish-jump a{font-size:13.5px;text-decoration:none;color:var(--muted)}
.wish-jump a b{font-family:var(--latin);font-weight:400;margin-left:6px;color:var(--sky-d)}
.wish-group{display:flex;align-items:baseline;gap:12px;margin:0 0 4px;padding-top:6px;font-family:var(--latin);font-weight:400;font-size:24px}
.wish-group:not(:first-child){margin-top:clamp(36px,5vh,56px)}
.wish-group .zh{font-family:var(--sans);font-size:12.5px;letter-spacing:.2em;color:var(--muted)}
.wl{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
.wl li{border-bottom:1px solid var(--line)}
.wl-btn{
  flex:1;min-width:0;display:grid;gap:2px;padding:12px 0;margin:0;border:0;background:none;cursor:pointer;
  font:inherit;color:var(--ink);text-align:left;
}
.wl-btn:hover .wl-name{color:var(--sky-d)}
.wl-top{display:flex;align-items:center;justify-content:space-between;gap:14px}
.wl-name{font-size:16px;font-weight:500;line-height:1.55}
.wl-sub{margin-top:2px;font-size:12.5px;color:var(--muted);letter-spacing:.06em}
.wl-sub .area{color:var(--sky-d);margin-right:8px}
.wl-maps{display:flex;gap:8px;flex:none}
.wl-maps a{
  display:grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid var(--line);
  font-family:var(--latin);font-size:14px;text-decoration:none;transition:border-color .3s;
}
.wl-maps a:hover{border-color:var(--ink)}
.wl-maps a.nv{background:#03c75a;border-color:#03c75a;color:#fff}
.wl-note{margin-top:8px;font-size:14px;line-height:1.9;color:var(--muted)}
.wl-meta{margin-top:6px;font-size:12px;color:var(--soft);overflow-wrap:anywhere}
.wl-links{display:flex;flex-wrap:wrap;gap:6px 22px;margin-top:6px}

/* ── 花費＋檢查：天藍漸層圓角大板，內放白卡（參考站中段那塊藍色橫幅） ── */
.band-sky{padding:0 var(--gut)}
.band-sky>.inner{max-width:1360px;margin:0 auto;border-radius:16px;background:linear-gradient(115deg,var(--sky-l),var(--sky) 70%);overflow:hidden}
:root[data-theme="dark"] .band-sky>.inner{background:linear-gradient(115deg,#173246,#1d5576 70%)}
.band-sky .section{padding:clamp(48px,8vh,88px) clamp(18px,4vw,56px) clamp(24px,4vh,40px)}
.band-sky .section-heading{color:#0b0b0e}
:root[data-theme="dark"] .band-sky .section-heading{color:var(--ink)}
.band-sky .section-heading p{color:#1e2a36}
:root[data-theme="dark"] .band-sky .section-heading p{color:var(--muted)}
.band-sky .panel{background:var(--card);border-radius:var(--r);padding:clamp(20px,3vw,36px);box-shadow:0 24px 50px -32px rgba(15,45,70,.6)}
.band-sky .handoff span{color:#1e2a36}
.band-sky .handoff span::before,.band-sky .handoff span::after{background:rgba(11,11,14,.25)}
.ledger-total{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 16px;padding-bottom:16px}
.ledger-total .lbl{flex-basis:100%;font-size:12.5px;letter-spacing:.2em;color:var(--muted)}
.ledger-yen{font-family:var(--latin);font-weight:400;font-size:clamp(34px,3.6vw,48px);line-height:1.15;font-variant-numeric:tabular-nums}
.ledger-twd{font-family:var(--latin);font-size:15px;color:var(--muted)}
.ledger-rate{flex-basis:100%;display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:6px;font-size:13px;color:var(--muted)}
.ledger-rate button,.ledger-btn{font:inherit;color:var(--ink);background:none;cursor:pointer;border:0;border-bottom:1px solid var(--ink);padding:2px 0;min-height:32px}
.ledger-rate button:hover,.ledger-btn:hover{color:var(--sky-d);border-color:var(--sky-d)}
.ledger-rate input{width:6.5em}
.ledger input{font:inherit;font-size:16px;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:8px 12px;min-height:46px;min-width:0}
.ledger input:focus{border-color:var(--sky);outline:none;box-shadow:0 0 0 3px var(--sky-t)}
.ledger input::placeholder{color:var(--soft)}
.ledger-warn{margin-bottom:10px;font-size:13px;color:var(--warm)}
.ledger-add{display:grid;grid-template-columns:minmax(0,14em) minmax(0,10em) auto;justify-content:start;gap:8px;padding:16px 0;border-top:1px solid var(--line)}
.ledger-yen-in{position:relative;display:block}
.ledger-yen-in::before{content:"₩";position:absolute;left:12px;top:50%;transform:translateY(-50%);font-family:var(--latin);color:var(--soft);pointer-events:none}
.ledger-yen-in input{width:100%;padding-left:28px;font-family:var(--latin);font-variant-numeric:tabular-nums}
.ledger-go{min-width:46px;min-height:46px;border:0;border-radius:6px;background:var(--sky);color:#0b0b0e;font:inherit;font-size:20px;cursor:pointer;transition:background .3s}
.ledger-go:hover{background:var(--sky-l)}
.lg-day{border-top:1px solid var(--line);padding-top:14px;margin-top:12px}
.lg-day h3{display:flex;align-items:baseline;gap:12px;font-size:14px;margin-bottom:2px}
.lg-no{font-family:var(--latin);letter-spacing:.14em;color:var(--sky-d)}
.lg-date{font-family:var(--latin);font-size:12.5px;color:var(--muted)}
.lg-sub{margin-left:auto;font-family:var(--latin);font-size:16px;font-weight:400}
.lg-day ul{list-style:none;margin:0;padding:0}
.lg-row{display:flex;width:100%;align-items:baseline;justify-content:space-between;gap:16px;font:inherit;color:inherit;text-align:left;background:none;border:0;cursor:pointer;padding:9px 0;min-height:44px;border-bottom:1px dashed var(--line)}
.lg-day li:last-child .lg-row{border-bottom:0}
.lg-name{font-size:15px;overflow-wrap:anywhere}
.lg-amt{font-family:var(--latin);font-size:16px;white-space:nowrap}
.lg-edit{display:grid;grid-template-columns:minmax(0,14em) minmax(0,10em);justify-content:start;gap:8px;padding:8px 0 12px}
.lg-edit-acts{grid-column:1/-1;display:flex;gap:20px;align-items:center}
.lg-edit-acts .del{color:var(--warm);border-color:var(--warm);margin-left:auto}
.ledger-empty{margin-top:14px;font-size:14px;color:var(--muted)}
.ledger-undo{position:fixed;left:50%;bottom:calc(20px + var(--nowbar-h,0px));z-index:45;transform:translateX(-50%);display:flex;align-items:center;gap:16px;background:var(--black);color:var(--on-black);border-radius:8px;padding:6px 8px 6px 16px;font-size:14px;max-width:calc(100% - 32px)}
.ledger-undo button{font:inherit;color:#0b0b0e;background:var(--sky);border:0;border-radius:6px;padding:0 14px;min-height:36px;cursor:pointer}
.ledger-undo span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.packing{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:clamp(16px,3vw,36px)}
.pack-group h3{font-size:13px;letter-spacing:.2em;padding-bottom:8px;border-bottom:1px solid var(--ink);margin-bottom:4px}
.pack-items{list-style:none;margin:0;padding:0}
.pack-items label{display:flex;gap:12px;align-items:flex-start;padding:8px 0;cursor:pointer;min-height:44px;font-size:14.5px;line-height:1.7}
.pack-items input{appearance:none;flex:none;width:20px;height:20px;margin:3px 0 0;border-radius:4px;border:1px solid var(--soft);display:grid;place-items:center;cursor:pointer;background:var(--card);transition:background .25s,border-color .25s}
.pack-items input::after{content:"";width:9px;height:5px;border:solid #0b0b0e;border-width:0 0 1.6px 1.6px;transform:rotate(-45deg) translate(1px,-1px);opacity:0}
.pack-items input:checked{background:var(--sky);border-color:var(--sky)}
.pack-items input:checked::after{opacity:1}
.pack-items input:checked+span{color:var(--soft);text-decoration:line-through}

/* ── 緊急：參考站的黑色頁尾——左邊字標與一句說明，右邊一欄一欄的名稱 ── */
#emergency{position:relative;margin-top:clamp(64px,10vh,120px);color:var(--on-black)}
#emergency::before{content:"";position:absolute;top:0;bottom:0;left:0;right:0;background:var(--black);z-index:0}
.ov-inner{position:relative;z-index:1;max-width:1360px;margin:0 auto;padding:clamp(56px,9vh,96px) var(--gut) clamp(40px,6vh,64px)}
.em-wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:clamp(28px,5vw,80px)}
.em-head .mark{fill:var(--on-black);width:56px;height:38px}
.em-head h2{margin-top:18px;font-family:var(--latin);font-weight:400;font-size:clamp(28px,3vw,40px)}
.em-sub{font-size:12.5px;letter-spacing:.2em;color:var(--on-black-mute);margin-top:4px}
.em-head p:last-child{margin-top:16px;font-size:13px;line-height:1.9;color:var(--on-black-mute)}
.em-cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(20px,3vw,44px);align-content:start}
.em-card{width:100%;display:flex;align-items:center;gap:14px;min-height:64px;padding:12px 0;border:0;border-bottom:1px solid #2a2e35;background:none;color:inherit;font:inherit;font-size:15px;text-align:left;cursor:pointer}
.em-icn svg{width:20px;height:20px;color:var(--sky);display:block}
.em-name{flex:1}
.em-go .pill{background:var(--on-black);color:var(--black)}
.em-card:hover .pill{transform:translateX(5px);background:var(--sky)}
.em-dlg{border:0;padding:0;border-radius:12px;max-width:min(480px,calc(100% - 32px));background:var(--card);color:var(--ink)}
.em-dlg::backdrop{background:rgba(11,11,14,.55);backdrop-filter:blur(4px)}
.em-dlg-in{padding:26px}
.em-dlg h3{font-size:18px}
.em-desc{margin-top:10px;font-size:15px;line-height:1.9;white-space:pre-line}
.em-dlg{max-height:86vh;overflow:auto;overscroll-behavior:contain}
.dlg-kicker{font-family:var(--latin);font-size:12.5px;letter-spacing:.14em;color:var(--sky-d)}
.dlg-kicker+h3{margin-top:4px}
.info-dlg h3:focus{outline:none}
.dlg-tag{margin-top:4px;font-size:13.5px;color:var(--muted)}
.dlg-links{display:grid;gap:4px;margin-top:16px}
.dlg-links .more{width:100%;font-size:14px}
.info-dlg .em-meta{padding-top:12px;border-top:1px solid var(--line)}
.info-dlg .em-close{margin-top:18px}
.em-meta{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:12px 0 0;font-size:13.5px}
.em-meta dt{color:var(--muted)}
.em-meta dd{margin:0}
.em-tel{display:flex;justify-content:center;align-items:center;margin-top:18px;min-height:54px;border-radius:8px;background:var(--sky);color:#0b0b0e;text-decoration:none;font-family:var(--latin);font-size:22px;letter-spacing:.06em}
.em-tel.is-todo{background:var(--sage);color:var(--muted);gap:10px;font-family:var(--sans);font-size:14px}
.em-todo-line{width:8em;border-bottom:1px dashed var(--muted)}
.em-close{margin-top:10px;width:100%;min-height:46px;border-radius:8px;border:1px solid var(--line);background:none;color:inherit;font:inherit;cursor:pointer}
.em-print{display:none}
html:not(.js) .em-dlg{display:block;position:static;margin:12px 0}
.coda{position:relative;z-index:1;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;max-width:1360px;margin:0 auto;padding:18px var(--gut) 28px;border-top:1px solid #2a2e35;font-size:12px;color:var(--on-black-mute);font-family:var(--latin);letter-spacing:.1em}
.footer-band{background:var(--black)}

/* ── 今日模式浮條 ── */
.now-bar{position:fixed;left:0;right:0;bottom:0;z-index:45;background:var(--black);color:var(--on-black)}
.now-inner{display:flex;align-items:center;gap:12px;max-width:1360px;margin:0 auto;padding:10px var(--gut)}
.now-bar .lbl{flex:1;min-width:0;font-size:14px;line-height:1.5}
.now-bar .lbl small{display:block;font-family:var(--latin);font-size:11px;letter-spacing:.16em;color:var(--sky)}
.now-go{display:grid;place-items:center;min-height:40px;padding:0 16px;border-radius:6px;background:var(--sky);color:#0b0b0e;text-decoration:none;font-size:13.5px}
.now-dismiss{width:40px;height:40px;border-radius:6px;border:1px solid #3a3f47;background:none;color:inherit;font-size:18px;cursor:pointer}

/* ── 頁內編輯器（?edit=1）：沿用原樣板 ── */
body.editing>*{display:none !important}
body.editing>#editor{display:block !important}
.editor{width:min(920px,100% - 40px);margin:0 auto;padding:28px 0 90px}
.ed-title{font-size:clamp(24px,4vw,32px);margin:0 0 6px;letter-spacing:.06em}
.ed-sub{color:var(--muted);margin:0 0 18px;line-height:1.8;max-width:60ch}
.ed-bar{position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:12px 0;margin-bottom:8px;background:var(--paper);border-bottom:1px solid var(--line)}
.ed-bar .spacer{flex:1}
.ed-btn{display:inline-flex;align-items:center;gap:6px;min-height:44px;padding:10px 16px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:14px;cursor:pointer;text-decoration:none}
.ed-btn.primary{background:var(--sky);color:#0b0b0e;border-color:var(--sky)}
.ed-save{color:var(--muted);font-size:13px}
.ed-sec{border:1px solid var(--line);border-radius:var(--r);background:var(--card);margin:16px 0;overflow:hidden}
.ed-sec>summary{cursor:pointer;list-style:none;padding:15px 20px;font-size:15px;background:var(--sage);letter-spacing:.06em}
.ed-sec>summary::-webkit-details-marker{display:none}
.ed-body{padding:16px 20px}
.ed-field{display:grid;gap:5px;margin-bottom:14px}
.ed-field label{font-size:12.5px;color:var(--muted);letter-spacing:.06em}
.ed-field input,.ed-field select,.ed-field textarea{font:inherit;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--ink);width:100%}
.ed-field textarea{min-height:60px;resize:vertical}
.ed-row{border:1px dashed var(--line);border-radius:8px;padding:14px;margin-bottom:12px}
.ed-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.ed-grid .full{grid-column:1/-1}
.ed-rowhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.ed-rowhead b{font-size:13px;color:var(--muted)}
.ed-del{background:none;border:1px solid var(--line);border-radius:6px;color:var(--warm);font:inherit;font-size:12px;padding:8px 12px;cursor:pointer;min-height:36px}
.ed-add{background:none;border:1px dashed var(--soft);border-radius:6px;color:var(--ink);font:inherit;font-size:13px;padding:11px 14px;cursor:pointer;width:100%;min-height:44px}
.ed-daytitle{font-size:16px;margin:4px 0 10px;letter-spacing:.06em}
.ed-strrow{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:8px}
.ed-strrow textarea{font:inherit;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--ink);min-height:46px;resize:vertical}
.draft-banner{width:min(920px,100% - 40px);margin:22px auto 0;background:var(--sky-t);border-radius:var(--r);padding:14px 18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.draft-banner span{flex:1;font-size:14px;min-width:60%}

/* ── 大字模式 ── */
[data-theme-size="large"] body{font-size:17.5px}
[data-theme-size="large"] .stop .desc,[data-theme-size="large"] .wl-note,[data-theme-size="large"] .tr-meta dd{font-size:16.5px;color:var(--ink)}
[data-theme-size="large"] .stop h4,[data-theme-size="large"] .wl-name{font-size:19px}
[data-theme-size="large"] .stop time{font-size:23px}

/* ── RWD ── */
@media (width<=980px){
  .nav-links a:not(.nav-urgent){display:none}
  .drawer-links{display:grid;gap:2px;padding-bottom:8px;margin-bottom:4px;border-bottom:1px solid var(--line)}
  .drawer-links a{display:flex;align-items:center;justify-content:space-between;min-height:46px;text-decoration:none;font-size:15px;letter-spacing:.1em}
  .day-grid{grid-template-columns:minmax(0,1fr)}
  .day-aside{position:static}
  .wish-wrap{grid-template-columns:minmax(0,1fr)}
  .wish-side{position:static}
  .wish-jump{display:flex;flex-wrap:wrap;gap:4px 18px}
  .em-wrap{grid-template-columns:minmax(0,1fr)}
}
@media (width<=760px){
  .hero{grid-template-columns:minmax(0,1fr);grid-template-rows:auto;padding-top:100px;min-height:0;gap:28px}
  .band-strip{height:min(62vw,300px)}
  .tools-menu{min-width:min(280px,calc(100vw - 32px))}
  .stop{grid-template-columns:50px minmax(0,1fr) auto;gap:10px}
  .stop time{font-size:15.5px}
  .stop-name{font-size:15.5px}
  .float-tab{display:none}
  .nav-tool[data-toggle="edit"]{display:none}
  .day-aside{padding:18px;box-shadow:0 10px 30px -24px rgba(41,45,51,.5)}
  .day-name{font-size:17px}
  /* 交通：照片只鋪在標題區，路線卡放回淺色底 */
  .band-photo::before,.band-photo::after{bottom:auto;height:var(--photo-h,400px)}
  .band-photo::after{background:linear-gradient(180deg,rgba(15,30,45,.5),rgba(15,30,45,.35) 70%,var(--paper))}
  .band-photo .daypick{justify-content:flex-start;border-bottom-color:var(--line)}
  .band-photo .dp{color:var(--soft)}
  .band-photo .dp:hover,.band-photo .dp[aria-current="page"]{color:var(--ink)}
  .tday-date{text-align:left;color:var(--ink)}
  .transit-row{box-shadow:none;border:1px solid var(--line)}
  /* 彈窗在 iPhone 上從底部升起，單手拇指就按得到關閉 */
  .em-dlg{width:100%;max-width:100%;margin:auto 0 0;border-radius:16px 16px 0 0;max-height:88vh}
  .em-dlg-in{padding:22px 20px calc(20px + env(safe-area-inset-bottom))}
  .em-dlg[open]{animation:sheet .35s var(--out)}
  .em-cards{grid-template-columns:minmax(0,1fr)}
  .ledger-add{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;justify-content:stretch}
  .lg-edit{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);justify-content:stretch}
  .ed-grid{grid-template-columns:1fr}
  .section{padding-top:56px}
  .float-tab{width:40px;font-size:12px;padding:10px 0 12px}
  .nav-links a.nav-urgent{height:36px;padding:0 14px;font-size:13px}
  .tr-meta div{grid-template-columns:minmax(0,1fr);gap:0}
}

/* ── 列印 ── */
@media print{
  :root{--paper:#fff;--ink:#222;--card:#fff;--muted:#444;--black:#fff;--on-black:#222;--on-black-mute:#444}
  .sticky-nav,.float-tab,.band-strip,.now-bar,.daybar,.handoff,.ledger,.em-cards,.em-dlg{display:none !important}
  .band-photo::before,.band-photo::after{display:none}
  .band-photo .section-heading,.tday-date{color:#222}
  .js .day,.js .tday{display:block !important}
  .em-print{display:block}
}
</style>
</head>
<body>
{#- DIRECTION CONTRACT
THESIS: 旅程手冊像一份安靜的不動產公司官網——大量留白、細體英文標、天藍只點一下；拒絕卡片牆與鮮豔貼紙。
OWN-WORLD: #f8f9fb 底、#292d33 字、天藍 #6ac3f1、Questrial 細英文、Noto Sans 400/500、10px 白卡浮在照片上、View more 黑膠囊箭頭、全黑頁尾。
STORY: 打開先看到首爾北村的弧形照片帶與出發倒數，往下是每天的行程、照片上的交通卡、口袋名單列表、藍色記帳板、黑色緊急聯絡。
FIRST VIEWPORT: 左側 72px 細體 Have a good trip.＋首爾 11/4–11/9 三人；右側五片北村照片弧形排開；左下是倒數；右下天藍直式浮標「交通」。
FORM: 使用者指定 jyuutaku-family.co.jp（brief-pinned）；code-led，無影像生成。
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-#}
<script id="trip-src" type="application/json">{{ data_json | safe }}</script>
<div class="editor" id="editor" hidden></div>
{%- set ns = namespace(live_cards=[], note_cards=[]) -%}
{%- for day in days -%}
  {%- for item in day["items"] -%}
    {%- if item.live_status -%}
      {%- set ls = item.live_status -%}
      {%- set _ = ns.live_cards.append({
        "title": item.name, "url": ls.source,
        "state": ls.status_zh or ls.status, "date": none,
        "tag": item.live_tag, "body": ls.summary_zh or ls.detail,
        "hours": none}) -%}
    {%- elif item.card -%}
      {%- set _ = ns.note_cards.append({
        "title": item.card.title or item.name, "url": item.card.url,
        "state": item.card.text, "date": item.card.date,
        "tag": item.card.tag, "body": item.card["body"],
        "hours": item.card.hours, "variant": item.card.variant,
        "route": item.card.route}) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set cards = ns.live_cards + ns.note_cards -%}
<a class="skip" href="#itinerary">跳至行程</a>

<nav class="sticky-nav" aria-label="快速跳轉">
  <div class="nav-inner">
    <a class="brand" href="#top" aria-label="回到封面">{{ mark() }}<span><small>SEOUL TRIP {{ trip.start_date[:4] }}</small><b>{{ trip.title }}旅程手冊</b></span></a>
    <div class="nav-links">
      <a href="#itinerary">行程</a>
      {%- if transit %}<a href="#transit">交通</a>{% endif %}
      {%- if wishlist %}<a href="#wishlist">口袋名單</a>{% endif %}
      <a href="#budget">花費</a>
      {%- if trip.packing %}<a href="#packing">出發前檢查</a>{% endif %}
      {%- if trip.emergency %}<a class="nav-urgent" href="#emergency">緊急聯絡</a>{% endif %}
    </div>
    <div class="nav-tools">
      <button class="tools-toggle" id="tools-toggle" type="button" aria-expanded="false" aria-controls="tools-menu" aria-label="開啟工具選單"><i></i><i></i><i></i></button>
      <div class="tools-menu" id="tools-menu">
        <div class="drawer-links">
          <a href="#itinerary">行程{{ pill() }}</a>
          {%- if transit %}<a href="#transit">交通{{ pill() }}</a>{% endif %}
          {%- if wishlist %}<a href="#wishlist">口袋名單{{ pill() }}</a>{% endif %}
          <a href="#budget">花費{{ pill() }}</a>
          {%- if trip.packing %}<a href="#packing">出發前檢查{{ pill() }}</a>{% endif %}
        </div>
        <button class="nav-tool" type="button" data-toggle="edit" aria-label="編輯行程資料">EDIT</button>
        <button class="nav-tool" type="button" data-toggle="theme" aria-pressed="false" aria-label="切換深色模式">DARK</button>
        <button class="nav-tool" type="button" data-toggle="size" aria-pressed="false" aria-label="切換大字模式">A+ 大字</button>
      </div>
    </div>
  </div>
</nav>

{% if transit %}
<a class="float-tab" href="#transit" aria-label="跳到交通">
  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14M8 21l2-4M16 21l-2-4"/><circle cx="8.5" cy="14" r=".6"/><circle cx="15.5" cy="14" r=".6"/></svg>
  <span>交通</span>
</a>
{% endif %}

<header class="hero" id="top">
  <div class="hero-copy">
    <h1>Have a good trip<br>in {{ (trip.hero_en or "Seoul") | title }}.</h1>
    <p class="sub">{{ trip.title }}・{{ trip.num_days }} 天 {{ trip.num_days - 1 }} 夜，{{ trip.travelers }} 個人的旅程</p>
    <p class="meta"><span>{{ trip.range_label }}</span>
</p>
  </div>
  <div class="band-strip" role="img" aria-label="北村韓屋村的巷弄，遠方是 N 首爾塔">
    <div class="row">
      {%- for ry, s, o in [("24deg", "1.1", "100%"), ("11deg", "1.03", "100%"), ("0deg", "1", "50%"), ("-11deg", "1.03", "0%"), ("-24deg", "1.1", "0%")] %}
      <span class="pn" style="--i:{{ loop.index0 }};--x:{{ loop.index0 * 25 }}%;--ry:{{ ry }};--s:{{ s }};--o:{{ o }}"></span>
      {%- endfor %}
    </div>
  </div>

  {%- if cards %}
  <div class="card-deck" id="card-deck">
    {%- for c in cards %}
    {%- if c.variant == "hello" %}
    <article class="card-live card-hello" data-i="{{ loop.index0 }}"
             data-start="{{ trip.start_date }}" data-end="{{ trip.end_date }}">
      <svg class="hello-stamp" aria-hidden="true"></svg>
      <p class="hello-head">Countdown</p>
      <p class="hello-fun" lang="en">{{ c.state }}</p>
      <div class="hello-stub">
        {%- if c.route %}
        <p class="hello-route" aria-label="{{ c.route[0] }} 飛往 {{ c.route[1] }}">
          <span>{{ c.route[0] }}</span><svg viewBox="0 0 28 8" aria-hidden="true" focusable="false"><path d="M0 4h26M22 1l4 3-4 3"/></svg><span>{{ c.route[1] }}</span></p>
        {%- endif %}
        <p class="hello-count" aria-live="off">
          <span class="hello-k">{{ trip.start_date[5:] | replace("-", ".") }}</span>
          <span class="hello-n">—</span>
          <span class="hello-u">{{ trip.end_date[5:] | replace("-", ".") }}</span></p>
      </div>
    </article>
    {%- else %}
    <article class="card-live" data-i="{{ loop.index0 }}"{% if c.hours %} data-hours='{{ c.hours | tojson }}'{% endif %}>
      <div class="top">
        {%- if c.url %}<a class="who" href="{{ c.url }}" target="_blank" rel="noopener">{{ c.title }}&nbsp;↗</a>
        {%- else %}<span class="who">{{ c.title }}</span>{%- endif %}
      </div>
      <p class="state">{{ c.state }}
        {%- if c.date %}<span class="upd">{{ c.date }}</span>{% endif %}
        {%- if c.tag %}<span class="live-tag">{{ c.tag }}</span>{% endif %}</p>
      {%- if c.body %}<p class="keys">{{ c.body }}</p>{%- endif %}
    </article>
    {%- endif %}
    {%- endfor %}
  </div>
  <script>
  (function(){
    var card = document.querySelector(".card-hello");
    if (!card) return;
    function day(s){ var p = s.split("-"); return new Date(+p[0], p[1]-1, +p[2]); }
    var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var start = day(card.dataset.start), end = day(card.dataset.end);
    var toGo = Math.round((start - today) / 864e5);
    var nth = Math.round((today - start) / 864e5) + 1;
    var total = Math.round((end - start) / 864e5) + 1;
    var k, n, u;
    if (toGo > 0)        { k = "出發倒數"; n = toGo; u = toGo === 1 ? "day" : "days"; }
    else if (nth <= total){ k = "旅途第";   n = nth;  u = "/ " + total + " 天"; }
    else                 { k = "歡迎回家"; n = "";   u = ""; card.classList.add("is-home"); }
    card.querySelector(".hello-k").textContent = k;
    card.querySelector(".hello-n").textContent = n;
    card.querySelector(".hello-u").textContent = u;
    card.classList.add("is-counted");
  })();
  </script>
  {%- endif %}
</header>

<main>
{% if pending %}
<div class="pending-banner">
  <details>
    <summary>還有 {{ pending | length }} 項待確認</summary>
    <ul>{% for p in pending %}<li><a href="#{{ p.anchor }}">{{ p.where }}</a> — {{ p.reason }}</li>{% endfor %}</ul>
  </details>
</div>
{% endif %}

{# ── 行程 ── #}
<div class="band band-b">
<section class="section" id="itinerary">
  <div class="section-heading">
    <h2>Itinerary</h2><span class="zh">行程</span>
  </div>
  <nav class="daypick" aria-label="選擇日期">
  {% for day in days %}
    <a class="dp" href="#day-{{ day.day_no }}" aria-label="Day {{ day.day_no }} {{ day.date_label }} {{ day.weekday }}">
      <b>{{ "%02d" | format(day.day_no) }}</b>
      <small>{{ day.date_short }}<i>{{ day.weekday }}</i></small>
    </a>
  {% endfor %}
  </nav>

  <div class="days">
  {% for day in days %}
    <section class="day" id="day-{{ day.day_no }}" data-date="{{ day.date }}"
             data-theme-text="Day {{ "%02d" | format(day.day_no) }}" aria-label="Day {{ day.day_no }} {{ day.date_label }}">
      <div class="day-grid">
        <div class="day-aside">
          <p class="day-num">Day {{ "%02d" | format(day.day_no) }}</p>
          <h3 class="day-name">{{ day.theme or "自由安排" }}</h3>
          <p class="day-date">{{ day.date_short }} {{ day.weekday }}</p>
          {%- set fc = day.forecast -%}
          {%- set wa = day.weather_area or {} -%}
          {%- set spots = [] %}
          {%- if fc and fc.hours %}{% set _ = spots.append((wa, fc)) %}{% endif %}
          {%- for a in day.forecast_areas or [] %}
            {%- for x in day.forecast_extra or [] %}{% if x.label == a.label and x.hours %}{% set _ = spots.append((a, x)) %}{% endif %}{% endfor %}
          {%- endfor %}
          {%- if spots %}
          {%- for a, f in spots %}
          <details class="wx-hours">
            <summary><span>{{ a.label }} <b>{{ f.tmin }}–{{ f.tmax }}°C</b></span><span class="wx-more">{{ "每小時" if f.step == 1 else "每 3 小時" }}</span></summary>
            <ol>
              {%- for h in f.hours %}
              <li{% if h.p is not none and h.p >= 50 %} class="wet"{% endif %}><span class="h">{{ h.h }}</span><b>{{ h.t }}°</b>
                {%- if h.p is not none %}<span class="p">{{ h.p }}%</span>{% endif %}</li>
              {%- endfor %}
            </ol>
            {%- if f.spread %}<p class="wx-spread">各模式差異大（{{ f.spread.what }} {{ f.spread.lo }}–{{ f.spread.hi }}°C），出發前再看一次</p>{%- endif %}
            <span class="wx-src">氣溫・降雨機率 · {{ f.model or "Open-Meteo" }} · {{ f.updated }} 更新</span>
            {%- if a.lat is not none and a.lon is not none %}
            <a class="more" href="https://www.windy.com/{{ a.lat }}/{{ a.lon }}?{{ a.lat }},{{ a.lon }},10" target="_blank" rel="noopener">Windy 逐時預報{{ pill() }}</a>
            {%- endif %}
          </details>
          {%- endfor %}
          {%- else %}
          {% if fc %}
          <p class="day-weather">{{ wa.label }} {{ fc.tmin }}–{{ fc.tmax }}°C
            {%- if fc.text %}・{{ fc.text }}{% endif %}
            {%- if fc["pop"] is not none %}・降雨 {{ fc["pop"] }}%{% endif %}
            <span class="wx-src">{{ fc.model or "Open-Meteo" }} 預報 · {{ fc.updated }} 更新</span></p>
          {% elif day.weather %}<p class="day-weather">{{ day.weather }}</p>{% endif %}
          {%- if fc and fc.spread %}<p class="wx-spread">各模式差異大（{{ fc.spread.what }} {{ fc.spread.lo }}–{{ fc.spread.hi }}°C），出發前再看一次</p>{%- endif %}
          {%- endif %}
          {% if day.route_url %}
          <a class="more" href="{{ day.route_url }}" target="_blank" rel="noopener">本日路線一鍵導航{{ pill() }}</a>
          {% if day.route_capped %}<span class="route-cap">點位較多，僅串接前段</span>{% endif %}
          {% endif %}
        </div>
      <ol class="timeline">
      {% for item in day["items"] %}
        <li class="stop {{ TYPE_META[item.type].cls if item.type in TYPE_META else '' }}" data-time="{{ item.time }}" data-name="{{ item.name }}"{% if item.map_url %} data-map="{{ item.map_url }}"{% endif %}>
          {%- set did = "stop-" ~ day.day_no ~ "-" ~ loop.index %}
          <time>{{ item.time }}</time>
          <button type="button" class="stop-name" data-dlg="{{ did }}" aria-haspopup="dialog">{{ item.name }}</button>
          {%- if item.map_url %}<a class="nav-btn" href="{{ item.map_url }}" aria-label="在地圖上開啟 {{ item.name }}">導航</a>{% endif %}
          <dialog class="em-dlg info-dlg" id="{{ did }}" aria-labelledby="{{ did }}-t">
            <div class="em-dlg-in">
              <p class="dlg-kicker">{{ day.date_short }} {{ day.weekday }}・{{ item.time }}</p>
              <h3 id="{{ did }}-t" tabindex="-1" autofocus>{{ item.name }}</h3>
              {% if item.note %}<p class="em-desc">{{ item.note }}</p>{% endif %}
              {% set meta = [] %}
              {%- if item.duration %}{% set _ = meta.append(("停留", item.duration)) %}{% endif %}
              {%- if item.booking and item.booking.hours %}{% set _ = meta.append(("營業", item.booking.hours)) %}{% endif %}
              {%- if item.booking and item.booking.code %}{% set _ = meta.append(("確認碼", item.booking.code)) %}{% endif %}
              {%- if item.next_transit %}{% set _ = meta.append(("下一站", item.next_transit)) %}{% endif %}
              {% if meta %}<dl class="em-meta">{% for k, v in meta %}<dt>{{ k }}</dt><dd>{{ v }}</dd>{% endfor %}</dl>{% endif %}
              <div class="dlg-links">
                {%- if item.map_url %}<a class="more" href="{{ item.map_url }}" target="_blank" rel="noopener">地圖{{ pill() }}</a>{% endif %}
                {%- if item.transit_url %}<a class="more" href="{{ item.transit_url }}" target="_blank" rel="noopener">到下一站的路線{{ pill() }}</a>{% endif %}
                {%- if item.url %}<a class="more" href="{{ item.url }}" target="_blank" rel="noopener">官網／訂房頁{{ pill() }}</a>{% endif %}
                {%- for lk in item.links %}<a class="more" href="{{ lk.url }}" target="_blank" rel="noopener">{{ lk.label }}{{ pill() }}</a>{% endfor %}
              </div>
              <button type="button" class="em-close" data-em-close>關閉</button>
            </div>
          </dialog>
        </li>
      {% endfor %}
      </ol>
      </div>
    </section>
  {% endfor %}
  </div>

  <div class="daybar">
    <button class="arw" id="day-prev" type="button" aria-label="前一天"><svg viewBox="0 0 24 12"><path d="M2 6h19M16 1.5 21 6l-5 4.5"/></svg></button>
    <span class="th" id="day-theme"></span>
    <button class="arw" id="day-next" type="button" aria-label="後一天"><svg viewBox="0 0 24 12"><path d="M2 6h19M16 1.5 21 6l-5 4.5"/></svg></button>
  </div>
</section>
</div>

{# ── 交通：滿版照片＋白卡 ── #}
{% if transit %}
<div class="band band-photo">
<section class="section" id="transit">
  <div class="section-heading">
    <h2>Transit</h2><span class="zh">交通</span>
    <p>要自己搭車的區間：哪條線、往哪個方向、幾號出口。（共 {{ transit | length }} 段）</p>
    {% if transit_note %}<p class="tr-note">{{ transit_note }}</p>{% endif %}
  </div>
  <nav class="daypick" aria-label="選擇交通日期">
  {% for day in transit_days %}
    <a class="dp" href="#transit-day-{{ day.day_no }}" aria-label="Day {{ day.day_no }} {{ day.date_label }} {{ day.weekday }}">
      <b>{{ "%02d" | format(day.day_no) }}</b>
      <small>{{ day.date_short }}<i>{{ day.weekday }}</i></small>
    </a>
  {% endfor %}
  </nav>
  <div class="tdays">
  {% for day in transit_days %}
    <section class="tday" id="transit-day-{{ day.day_no }}" data-date="{{ day.date }}"
             data-theme-text="Day {{ day.day_no }}" aria-label="Day {{ day.day_no }} {{ day.date_label }} 的交通">
      <p class="tday-date">{{ day.date_short }} {{ day.weekday }}<span>{{ day.theme or "自由安排" }}</span></p>
      <div class="transit-list">
      {% for t in day.transit %}
      <div class="transit-row">
        <div class="tr-head">
          {%- if t.when %}<span class="tr-when">{{ t.when }}</span>{% endif %}
          {%- if t.url %}<a class="tr-route" href="{{ t.url }}" target="_blank" rel="noopener">{{ t.route }}</a>
          {%- else %}<b class="tr-route">{{ t.route }}</b>{%- endif %}
        </div>
        <dl class="tr-meta">
          {%- if t.line %}<div><dt>路線</dt><dd>{%- if t.line_color %}<i class="tr-dot" style="--lc:{{ t.line_color }}"></i>{% endif %}{{ t.line }}</dd></div>{%- endif %}
          {%- if t.platform %}<div><dt>方向</dt><dd>{{ t.platform }}</dd></div>{% endif %}
          {%- if t.time %}<div><dt>時間</dt><dd>{{ t.time }}</dd></div>{% endif %}
          {%- if t.fare %}<div><dt>票價</dt><dd>{{ t.fare }}</dd></div>{% endif %}
          {%- if t.exit %}<div><dt>出口</dt><dd>{{ t.exit }}</dd></div>{% endif %}
          {%- if t.warn %}<div class="tr-warn"><dt>注意</dt><dd>{{ t.warn }}</dd></div>{% endif %}
        </dl>
      </div>
      {% endfor %}
      </div>
    </section>
  {% endfor %}
  </div>
  {%- if transit_links %}
  <div class="transit-links">
    {%- for l in transit_links %}<a class="more" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}{{ pill() }}</a>{%- endfor %}
  </div>
  {%- endif %}
</section>
</div>
{% endif %}

{# ── 口袋名單 ── #}
{% if wishlist %}
{%- set CAT_EN = {"食物": "Eat", "逛街": "Shop", "景點": "See", "住宿": "Stay"} -%}
<div class="band band-b">
<section class="section" id="wishlist">
  <div class="wish-wrap">
    <div class="wish-side">
      <div class="section-heading">
        <h2>Pocket list</h2><span class="zh">口袋名單</span>
        <p>想去、但還沒排進行程的地方。（共 {{ wishlist | length }} 處）</p>
      </div>
      <nav class="wish-jump" aria-label="口袋名單分類">
        {%- for g in wishlist_groups %}<a href="#wish-{{ loop.index }}">{{ g.label }}<b>{{ g["items"] | length }}</b></a>{% endfor %}
      </nav>
    </div>
    <div>
    {% for g in wishlist_groups %}{% set gloop = loop %}
      <h3 class="wish-group" id="wish-{{ loop.index }}">{{ CAT_EN.get(g.label, g.label) }}<span class="zh">{{ g.label }}</span></h3>
      <ul class="wl">
      {% for w in g["items"] %}
        {%- set wid = "wish-" ~ gloop.index ~ "-" ~ loop.index %}
        <li>
          <div class="wl-top">
            <button type="button" class="wl-btn" data-dlg="{{ wid }}" aria-haspopup="dialog">
              <span class="wl-name">{{ w.name }}</span>
              {%- if w.area or w.tagline %}<span class="wl-sub">{% if w.area %}<span class="area">{{ w.area }}</span>{% endif %}{{ w.tagline or "" }}</span>{% endif %}
            </button>
            <div class="wl-maps">
              {%- if w.naver_url %}<a class="nv" href="{{ w.naver_url }}" target="_blank" rel="noopener" aria-label="{{ w.name }} 在 Naver 地圖">N</a>{% endif %}
              {%- if w.map_url %}<a href="{{ w.map_url }}" target="_blank" rel="noopener" aria-label="{{ w.name }} 在 Google 地圖">G</a>{% endif %}
            </div>
          </div>
          <dialog class="em-dlg info-dlg" id="{{ wid }}" aria-labelledby="{{ wid }}-t">
            <div class="em-dlg-in">
              {% if w.area %}<p class="dlg-kicker">{{ w.area }}</p>{% endif %}
              <h3 id="{{ wid }}-t" tabindex="-1" autofocus>{{ w.name }}</h3>
              {% if w.tagline %}<p class="dlg-tag">{{ w.tagline }}</p>{% endif %}
              {% if w.note %}<p class="em-desc">{{ w.note }}</p>{% endif %}
              {%- if w.address or w.hours %}
              <dl class="em-meta">
                {%- if w.hours %}<dt>營業</dt><dd>{{ w.hours }}</dd>{% endif %}
                {%- if w.address %}<dt>地址</dt><dd>{{ w.address }}</dd>{% endif %}
              </dl>
              {%- endif %}
              <div class="dlg-links">
                {%- if w.naver_url %}<a class="more" href="{{ w.naver_url }}" target="_blank" rel="noopener">Naver 地圖{{ pill() }}</a>{% endif %}
                {%- if w.map_url %}<a class="more" href="{{ w.map_url }}" target="_blank" rel="noopener">Google 地圖{{ pill() }}</a>{% endif %}
                {%- if w.url %}<a class="more" href="{{ w.url }}" target="_blank" rel="noopener">官網{{ pill() }}</a>{% endif %}
                {%- for lk in w.links %}<a class="more" href="{{ lk.url }}" target="_blank" rel="noopener">{{ lk.label }}{{ pill() }}</a>{% endfor %}
              </div>
              <button type="button" class="em-close" data-em-close>關閉</button>
            </div>
          </dialog>
        </li>
      {% endfor %}
      </ul>
    {% endfor %}
    </div>
  </div>
</section>
</div>
{% endif %}

{# ── 花費＋檢查：天藍漸層大板 ── #}
<div class="band band-sky">
<div class="inner">
<section class="section" id="budget">
  <div class="section-heading">
    <h2>Budget</h2><span class="zh">花費</span>
    <p>自己的記帳，只存在這支手機、不會上傳。</p>
  </div>
  <div class="panel">
  <div class="ledger" id="ledger" hidden
       data-rate="{{ (trip.fx and trip.fx.rate) or 41 }}"
       data-start="{{ trip.start_date }}" data-end="{{ trip.end_date }}">
    <div class="ledger-total">
      <span class="lbl">合計</span>
      <b class="ledger-yen" id="ledger-yen">₩0</b>
      <span class="ledger-twd" id="ledger-twd">≈ NT$0</span>
      <div class="ledger-rate" id="ledger-rate"></div>
    </div>
    <p class="ledger-warn" id="ledger-warn" hidden>這個瀏覽器不允許存資料（可能是無痕模式），關掉頁面記錄就會消失。</p>
    <form class="ledger-add" id="ledger-add" autocomplete="off">
      <input class="ledger-name-in" name="name" maxlength="40" placeholder="品項" aria-label="品項">
      <span class="ledger-yen-in"><input name="yen" inputmode="numeric" placeholder="金額" aria-label="金額（韓元）"></span>
      <button class="ledger-go" type="submit" aria-label="新增這筆">＋</button>
    </form>
    <div id="ledger-list"></div>
    <p class="ledger-empty" id="ledger-empty">還沒有記錄。輸入品項與韓元金額按「＋」就會記下，依天自動分組。</p>
  </div>
  <noscript><p class="ledger-empty">記帳需要開啟 JavaScript。</p></noscript>
  </div>
  <div class="ledger-undo" id="ledger-undo" role="status" aria-live="polite" hidden></div>
</section>

{% if trip.packing %}
<section class="section" id="packing">
  <div class="section-heading">
    <h2>Checklist</h2><span class="zh">出發前檢查</span>
    <p>出發前一項一項勾，勾選狀態會記在這台裝置。</p>
  </div>
  <div class="panel">
  <div class="packing">
  {% if trip.packing[0] is string %}
    <div class="pack-group"><ul class="pack-items">
      {% for it in trip.packing %}<li><label><input type="checkbox" data-pack="flat:{{ loop.index }}"><span>{{ it }}</span></label></li>{% endfor %}
    </ul></div>
  {% else %}
    {% for group in trip.packing %}
    <div class="pack-group">
      {% if group.group %}<h3>{{ group.group }}</h3>{% endif %}
      <ul class="pack-items">
      {% for it in group["items"] %}<li><label><input type="checkbox" data-pack="{{ group.group }}:{{ loop.index }}"><span>{{ it }}</span></label></li>{% endfor %}
      </ul>
    </div>
    {% endfor %}
  {% endif %}
  </div>
  </div>
</section>
{% endif %}
</div>
</div>

{# ── 緊急：黑色頁尾 ── #}
{% if trip.emergency %}
<section id="emergency">
  <div class="ov-inner">
    <div class="em-wrap">
      <div class="em-head">
        {{ mark() }}
        <h2>Emergency</h2>
        <p class="em-sub">緊急聯絡</p>
        <p><span class="em-hint">點任一項目看說明與電話。</span>韓國境內撥號不需國碼。</p>
      </div>
      <ul class="em-cards">
      {% for e in trip.emergency %}
        <li>
          <button type="button" class="em-card" data-em="{{ loop.index0 }}" aria-haspopup="dialog" aria-controls="em-dlg-{{ loop.index0 }}">
            <span class="em-icn">{{ em_icon(loop.index0) }}</span>
            <span class="em-name">{{ e.label }}</span>
            <span class="em-go" aria-hidden="true">{{ pill() }}</span>
          </button>
        </li>
      {% endfor %}
      </ul>
    </div>
    {% for e in trip.emergency %}
    <dialog class="em-dlg" id="em-dlg-{{ loop.index0 }}" aria-labelledby="em-dlg-t-{{ loop.index0 }}">
      <div class="em-dlg-in">
        <h3 id="em-dlg-t-{{ loop.index0 }}">{{ e.name or e.label }}</h3>
        {% if e.desc %}<p class="em-desc">{{ e.desc }}</p>{% endif %}
        {%- if e.address or e.hours %}
        <dl class="em-meta">
          {%- if e.address %}<dt>地址</dt><dd>{{ e.address }}</dd>{% endif %}
          {%- if e.hours %}<dt>服務時間</dt><dd>{{ e.hours }}</dd>{% endif %}
        </dl>
        {%- endif %}
        {% if e.tel %}<a class="em-tel" href="tel:{{ e.tel }}">{{ e.tel }}</a>
        {% else %}<p class="em-tel is-todo"><span class="em-todo-line"></span><span class="em-todo-tag">待填</span></p>{% endif %}
        <button type="button" class="em-close" data-em-close aria-label="關閉">關閉</button>
      </div>
    </dialog>
    {% endfor %}
    <div class="em-print">
      {% for e in trip.emergency %}<p><b>{{ e.name or e.label }}</b> {{ e.tel or "（電話待填）" }} {{ e.desc or "" }}</p>{% endfor %}
    </div>
  </div>
  <div class="coda">
    <span class="d">{{ trip.range_label }}</span>
    <span class="t">{{ trip.title }}旅程手冊</span>
  </div>
</section>
{% endif %}
</main>

<div class="now-bar" hidden>
  <div class="now-inner">
    <span class="lbl"></span>
    <a class="now-go" href="#" target="_blank" rel="noopener" hidden>導航 ↗</a>
    <button class="now-dismiss" type="button" aria-label="關閉今日模式">×</button>
  </div>
</div>

{% include '_scripts.j2' %}

<script>
/* 行程與口袋名單：點名稱開彈窗 */
[].slice.call(document.querySelectorAll("[data-dlg]")).forEach(function(b){
  b.addEventListener("click", function(){
    var d = document.getElementById(b.getAttribute("data-dlg"));
    if (!d) return;
    if (typeof d.showModal === "function") d.showModal(); else d.setAttribute("open", "");
  });
});
</script>
<script>
/* 頂列：一捲動就加上半透明底，蓋在內容上也看得清楚 */
(function(){
  var r = document.documentElement;
  function f(){ r.classList.toggle("scrolled", scrollY > 24); }
  addEventListener("scroll", f, {passive:true}); f();
})();
</script>
<script>
/* PWA：僅在 http/https 下註冊 service worker；file:// 單檔開啟時略過，不影響離線單檔用法 */
if ("serviceWorker" in navigator && location.protocol.indexOf("http") === 0) {
  window.addEventListener("load", function(){
    // 記住載入時是否已被舊版 SW 控制：首次安裝為 false，用來避免第一次進站誤重整
    var hadController = !!navigator.serviceWorker.controller;
    navigator.serviceWorker.register("sw.js").then(function(reg){
      if (reg && reg.update) { try { reg.update(); } catch (e) {} }  // 每次開啟主動查有無新版
    }).catch(function(){});
    // 新版 SW 接管後自動重整一次，讓主畫面 App 不用手動刷就看到新內容
    var refreshing = false;
    navigator.serviceWorker.addEventListener("controllerchange", function(){
      if (refreshing || !hadController) return;  // 首次安裝（本來沒有 controller）不重整
      refreshing = true;
      location.reload();
    });
  });
  // 從背景喚醒（切回主畫面 App）時再查一次更新，抓到就會走上面的自動重整
  document.addEventListener("visibilitychange", function(){
    if (document.visibilityState === "visible" && navigator.serviceWorker.controller) {
      navigator.serviceWorker.getRegistration().then(function(reg){
        if (reg && reg.update) { try { reg.update(); } catch (e) {} }
      }).catch(function(){});
    }
  });
}
</script>
</body>
</html>
