{#- 首爾外觀（trip.skin = "seoul"）。只覆蓋 token 與少數版式，
    結構與互動沿用主模板。參考 muuuuu.org「白色系／單色調」：
    純白底、近黑字、大量留白、粗黑英文大標配韓文小字、編號清單。
    字型連線載 Pretendard，離線退回系統韓文黑體。 -#}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root[data-skin="seoul"]{
  --paper:#ffffff; --ink:#111111; --line:#e6e6e6; --card:#ffffff;
  --muted:#8a8a8a; --pine:#111111; --sage:#f4f4f4;
  --paper-0:rgba(255,255,255,0);
  --sans:"Pretendard Variable",Pretendard,"Apple SD Gothic Neo","Malgun Gothic",
         "Noto Sans KR","Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;
  --latin:var(--sans);
  --w:500;
}
:root[data-skin="seoul"][data-theme="dark"]{
  --paper:#0e0e0e; --ink:#f2f2f2; --line:#2a2a2a; --card:#161616;
  --muted:#8f8f8f; --pine:#f2f2f2; --sage:#161616;
  --paper-0:rgba(14,14,14,0);
}
[data-skin="seoul"] body{letter-spacing:-.01em}
/* 分帶全部回到同一張白紙，層級交給細線與字級 */
[data-skin="seoul"] .band-b,[data-skin="seoul"] .band-c,[data-skin="seoul"] .band-e{--band:var(--paper);--prev:var(--paper)}

/* ── 封面：靠左的大標 ── */
[data-skin="seoul"] .hero{align-items:stretch;justify-content:flex-start;min-height:88svh;
  max-width:1440px;margin:0 auto;padding-top:clamp(84px,12vh,120px)}
[data-skin="seoul"] .hero-top{display:flex;justify-content:space-between;
  font-size:12px;letter-spacing:.24em;text-transform:uppercase}
[data-skin="seoul"] .hero h1{text-align:left;font-size:clamp(72px,19vw,220px);line-height:.92;
  font-weight:800;letter-spacing:-.045em;margin-top:clamp(56px,12vh,140px)}
[data-skin="seoul"] .hero-ko{margin-top:14px;font-size:clamp(14px,1.3vw,17px);letter-spacing:.5em;color:var(--muted)}
[data-skin="seoul"] .hero .lead{text-align:left;margin:clamp(40px,7vh,80px) 0 0;max-width:30em;
  font-size:15px;font-weight:500;color:var(--muted)}
[data-skin="seoul"] .hero-pills{justify-content:flex-start;gap:0;margin-top:18px;padding-top:14px;border-top:1px solid var(--ink)}
[data-skin="seoul"] .hero-pills span{height:auto;padding:0;border:0;font-size:12px;letter-spacing:.18em;text-transform:uppercase}
[data-skin="seoul"] .hero-pills span+span::before{content:"·";margin:0 .8em;color:var(--muted)}
[data-skin="seoul"] .hero .drop{display:none}

/* ── 章節標題 ── */
[data-skin="seoul"] .section-heading h2{font-size:clamp(30px,4vw,48px);font-weight:800;letter-spacing:-.03em}
[data-skin="seoul"] .section-heading p{font-weight:500}

/* ── 口袋名單：編號清單 ── */
[data-skin="seoul"] .wish-group{margin-top:clamp(36px,6vh,64px);border-bottom:1px solid var(--ink);
  font-size:12px;font-weight:600;letter-spacing:.24em;color:var(--muted);padding-bottom:10px}
[data-skin="seoul"] .wish-group small{display:none}
.wl{list-style:none;margin:0;padding:0}
.wl>li{border-bottom:1px solid var(--line)}
.wl summary{display:grid;grid-template-columns:2.4em minmax(0,1fr) auto;gap:12px;align-items:baseline;
  padding:16px 0;cursor:pointer;list-style:none}
.wl summary::-webkit-details-marker{display:none}
.wl .no{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.wl .nm{font-size:clamp(16px,1.4vw,19px);font-weight:700;letter-spacing:-.01em;line-height:1.5}
.wl .sub{display:block;font-size:13px;font-weight:500;color:var(--muted);margin-top:2px}
.wl .maps{display:flex;gap:2px;font-size:12px;letter-spacing:.08em;white-space:nowrap}
.wl .maps a{text-decoration:none;display:inline-flex;align-items:center;justify-content:center;
  min-width:30px;min-height:30px;border-bottom:1px solid transparent}
.wl .maps a:hover{border-color:currentColor}
.wl .maps i{font-style:normal;color:var(--line);align-self:center}
.wl .body{padding:0 0 18px calc(2.4em + 12px);font-size:14.5px;font-weight:500;line-height:1.85;color:var(--muted)}
.wl .body p{margin:0 0 6px;max-width:42em}
.wl .body .addr{color:var(--ink)}
.wl .body a{color:var(--ink)}
.wl details[open] .nm{text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
@media (width<=560px){ .wl .maps a{min-width:40px;min-height:40px} }
@media print{ .wl details>.body{display:block} }
</style>
